<Page
    x:Class="QingShu.Toolkit.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:QingShu.Toolkit.ViewModels">

    <ScrollViewer Padding="28,20,28,20">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Spacing="14">
            <StackPanel.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.Transitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource PageTitleTextBlock}" />
                    <TextBlock Text="所有配置即时保存并生效，数据存储于本机 %LOCALAPPDATA%\QingShu.Toolkit\config.json。"
                               Style="{StaticResource PageSubtitleTextBlock}" />
                </StackPanel>
                <TextBlock Text="{x:Bind Vm.SavedTip, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Style="{StaticResource CaptionTextBlock}" Foreground="{ThemeResource SuccessTextBrush}" />
            </Grid>

            <!-- 外观 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="外观" Style="{StaticResource SectionTitleTextBlock}" />
                    <RadioButtons Header="主题" SelectedIndex="{x:Bind Vm.ThemeIndex, Mode=TwoWay}">
                        <RadioButton Content="跟随系统" />
                        <RadioButton Content="浅色" />
                        <RadioButton Content="深色" />
                    </RadioButtons>
                    <ToggleSwitch Header="窗口亚克力材质" OnContent="开启（推荐）" OffContent="关闭（不透明）"
                                  IsOn="{x:Bind Vm.UseAcrylic, Mode=TwoWay}" />
                    <TextBlock Text="Win10 使用 DesktopAcrylic（深色下自动提高不透明度保证可读性）；Win11 自动升级为 Mica。"
                               Style="{StaticResource CaptionTextBlock}" />
                </StackPanel>
            </Border>

            <!-- 网络诊断 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="网络诊断" Style="{StaticResource SectionTitleTextBlock}" />
                    <TextBox Header="城域网认证门户地址" PlaceholderText="如 http://10.10.10.55 或认证域名"
                             Text="{x:Bind Vm.PortalBaseUrl, Mode=TwoWay}" Style="{StaticResource SettingTextBox}" />
                    <TextBox Header="认证状态接口（可选，用于精确判定过期）" PlaceholderText="如 http://门户/status"
                             Text="{x:Bind Vm.AuthStatusUrl, Mode=TwoWay}" Style="{StaticResource SettingTextBox}" />
                    <TextBox Header="在线判定关键字（| 分隔）" Text="{x:Bind Vm.AuthOkKeywords, Mode=TwoWay}"
                             Style="{StaticResource SettingTextBox}" />
                    <TextBox Header="校园内网探测地址（教体局 OA / 内网资源）" PlaceholderText="IP 或内网域名"
                             Text="{x:Bind Vm.IntranetProbeHost, Mode=TwoWay}" Style="{StaticResource SettingTextBox}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Header="首选 DNS" Text="{x:Bind Vm.DnsPreferred, Mode=TwoWay}" Width="180" />
                        <TextBox Header="备用 DNS" Text="{x:Bind Vm.DnsAlternate, Mode=TwoWay}" Width="180" />
                    </StackPanel>
                    <TextBlock Text="填写后可对“教体局城域网登录授权过期”做出精确判定，并生成更针对性的处置建议。"
                               Style="{StaticResource CaptionTextBlock}" />
                </StackPanel>
            </Border>

            <!-- 磁盘清理 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="磁盘清理" Style="{StaticResource SectionTitleTextBlock}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Header="微信/QQ 久远阈值（天）" Text="{x:Bind Vm.ImOldDaysText, Mode=TwoWay}" Width="200" />
                        <TextBox Header="大文件阈值（MB）" Text="{x:Bind Vm.LargeMinMbText, Mode=TwoWay}" Width="200" />
                    </StackPanel>
                    <ToggleSwitch Header="默认删除方式" OnContent="移入回收站（安全，可恢复）" OffContent="直接删除（释放更快，不可恢复）"
                                  IsOn="{x:Bind Vm.DeleteToRecycleBin, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- 功耗 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="功耗管理" Style="{StaticResource SectionTitleTextBlock}" />
                    <RadioButtons Header="功耗模式（状态栏三色小标识）" SelectedIndex="{x:Bind Vm.PowerModeIndex, Mode=TwoWay}">
                        <RadioButton Content="自动（接电源=高性能 / 电池=低功耗）" />
                        <RadioButton Content="手动·平衡" />
                        <RadioButton Content="手动·高性能" />
                        <RadioButton Content="手动·低功耗（EcoQoS）" />
                    </RadioButtons>
                    <ToggleSwitch Header="对本程序应用 EcoQoS" OnContent="开启（低功耗态自动降频）" OffContent="关闭"
                                  IsOn="{x:Bind Vm.ApplyEcoQosToSelf, Mode=TwoWay}" />
                    <TextBlock Text="功耗标识色仅用于状态栏小圆点：绿=低功耗 / 蓝=平衡 / 红=高性能，不做大面积填充以免干扰教学场景。"
                               Style="{StaticResource CaptionTextBlock}" />
                </StackPanel>
            </Border>

            <!-- 弹窗拦截 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="弹窗拦截" Style="{StaticResource SectionTitleTextBlock}" />
                    <ToggleSwitch Header="被动弹窗拦截（全局白名单策略）" OnContent="开启" OffContent="关闭"
                                  IsOn="{x:Bind Vm.PopupEnabled, Mode=TwoWay}" />
                    <TextBlock Text="白名单在「性能优化」页管理。默认放行系统、浏览器、Office、希沃、QQ/微信等教学常用软件。"
                               Style="{StaticResource CaptionTextBlock}" />
                </StackPanel>
            </Border>

            <!-- 自动更新 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="自动更新（询问式）" Style="{StaticResource SectionTitleTextBlock}" />
                    <ToggleSwitch Header="自动检查更新" OnContent="开启（每 24 小时一次）" OffContent="关闭"
                                  IsOn="{x:Bind Vm.AutoCheckUpdate, Mode=TwoWay}" />
                    <TextBox Header="GitHub 仓库" Text="{x:Bind Vm.UpdateRepo, Mode=TwoWay}" Style="{StaticResource SettingTextBox}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Command="{x:Bind Vm.CheckUpdateCommand}" Content="立即检查更新" />
                        <Button Command="{x:Bind Vm.DownloadUpdateCommand}" Content="下载更新"
                                Visibility="{x:Bind Vm.UpdateAvailable, Mode=OneWay}" />
                        <Button Command="{x:Bind Vm.InstallUpdateCommand}" Content="立即安装" Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind Vm.UpdateDownloaded, Mode=OneWay}" />
                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind Vm.IsUpdateBusy, Mode=OneWay}" />
                    </StackPanel>
                    <ProgressBar Value="{x:Bind Vm.UpdateProgress, Mode=OneWay}" Maximum="100" CornerRadius="2"
                                 Visibility="{x:Bind Vm.IsUpdateBusy, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Vm.UpdateStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                               Foreground="{ThemeResource InfoTextBrush}" />
                    <TextBlock Text="更新流程为询问式：发现新版本 → 询问 → 下载（进度可见）→ 再次询问 → 退出并自动替换重启。校园网若无法访问 GitHub，可离线替换安装包。"
                               Style="{StaticResource CaptionTextBlock}" />
                </StackPanel>
            </Border>

            <!-- 日志 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="日志" Style="{StaticResource SectionTitleTextBlock}" />
                    <TextBox Header="日志保留天数" Text="{x:Bind Vm.LogRetentionText, Mode=TwoWay}" Width="200" />
                    <TextBlock Text="{x:Bind Vm.LogRootText, Mode=OneWay}" Style="{StaticResource MonoTextBlock}" IsTextSelectionEnabled="True" />
                    <TextBlock Text="诊断日志按「日期 → 当日次数」分文件留存；超期日志启动时自动清理。"
                               Style="{StaticResource CaptionTextBlock}" />
                </StackPanel>
            </Border>

            <!-- 保存与重置 / 关于 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.SaveManualCommand}" Content="保存全部设置" />
                        <Button Command="{x:Bind Vm.ResetSettingsCommand}" Content="恢复默认设置" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap">
                        <Run Text="青枢工具箱 v" /><Run Text="{x:Bind Vm.VersionText, Mode=OneWay}" /><Run Text=" · 基于 .NET 8 + WinUI 3（Windows App SDK 1.6）+ QuestPDF · MIT License" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap"
                               Text="隐私承诺：所有诊断、清理、报告数据仅在本机处理与留存，不上传任何数据；唯一联网行为是检查 GitHub 更新（可关闭）。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
