<Page
    x:Class="QingShu.Toolkit.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:QingShu.Toolkit.ViewModels">

    <Grid RowSpacing="12" Padding="28,20,28,12">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="12" IsStaggeringEnabled="True" />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="日志查看" Style="{StaticResource PageTitleTextBlock}" />
                <TextBlock Text="诊断日志按「日期文件夹 → 当日第 N 次」分文件留存（.log 可读版 + .jsonl 结构化版），全部保留在本机。"
                           Style="{StaticResource PageSubtitleTextBlock}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Command="{x:Bind Vm.OpenFolderCommand}" Content="打开日志文件夹" />
                <Button Command="{x:Bind Vm.RefreshDatesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Sync" /><TextBlock Text="刷新" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 日期 -->
            <Border Style="{StaticResource CardStyle}" Padding="8">
                <ListView ItemsSource="{x:Bind Vm.Dates, Mode=OneWay}"
                          SelectedItem="{x:Bind Vm.SelectedDate, Mode=TwoWay}" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogDateVm">
                            <TextBlock Text="{x:Bind Header}" Style="{StaticResource BodyTextBlock}" Margin="6,4" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- 文件 -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="8">
                <ListView ItemsSource="{x:Bind Vm.Files, Mode=OneWay}"
                          SelectedItem="{x:Bind Vm.SelectedFile, Mode=TwoWay}" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogFileVm">
                            <Grid Margin="6,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind FileName}" Style="{StaticResource CaptionTextBlock}"
                                           Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" Style="{StaticResource CaptionTextBlock}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- 预览 -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Vm.RetentionText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}" />
                    <TextBox Grid.Row="1" Text="{x:Bind Vm.PreviewText, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="NoWrap" AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{ThemeResource TextSecondaryBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
