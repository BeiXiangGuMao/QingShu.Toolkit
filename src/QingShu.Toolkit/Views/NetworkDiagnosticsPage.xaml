<Page
    x:Class="QingShu.Toolkit.Views.NetworkDiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:QingShu.Toolkit.ViewModels"
    xmlns:m="using:QingShu.Toolkit.Models">

    <Grid RowSpacing="12" Padding="28,20,28,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 + 启动区 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="网络诊断" Style="{StaticResource PageTitleTextBlock}" />
                <TextBlock Text="傻瓜模式：点一下就开始。全面诊断覆盖物理链路、认证、内外网与系统栈全链路；网速模式专门分析“变慢”的原因并给出可执行的提速修复；发现问题可一键修复，修复不了可导出 PDF 报告。"
                           Style="{StaticResource PageSubtitleTextBlock}" MaxWidth="760" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                <ComboBox x:Name="ModeCombo" SelectedIndex="{x:Bind Vm.ModeIndex, Mode=TwoWay}"
                          MinWidth="170" VerticalAlignment="Center">
                    <ComboBoxItem Content="全面诊断（约2-4分钟）" />
                    <ComboBoxItem Content="快速体检（约30-60秒）" />
                    <ComboBoxItem Content="网速与低速分析（约1-2分钟）" />
                </ComboBox>
                <Button x:Name="BtnStart" Style="{StaticResource AccentButtonStyle}" Padding="22,8"
                        Command="{x:Bind Vm.StartCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock Text="开始诊断" />
                    </StackPanel>
                </Button>
                <Button Content="取消" Command="{x:Bind Vm.CancelCommand}"
                        IsEnabled="{x:Bind Vm.IsRunning, Mode=OneWay}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 进度卡 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,12,16,12">
            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock Text="{x:Bind Vm.ProgressText, Mode=OneWay}" Style="{StaticResource BodyTextBlock}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Border Background="{ThemeResource SuccessChipFillBrush}" CornerRadius="99" Padding="10,2">
                            <TextBlock Text="{x:Bind Vm.PassCountText, Mode=OneWay}" Foreground="{ThemeResource SuccessTextBrush}" FontSize="12" />
                        </Border>
                        <Border Background="{ThemeResource WarningChipFillBrush}" CornerRadius="99" Padding="10,2">
                            <TextBlock Text="{x:Bind Vm.WarnCountText, Mode=OneWay}" Foreground="{ThemeResource WarningTextBrush}" FontSize="12" />
                        </Border>
                        <Border Background="{ThemeResource ErrorChipFillBrush}" CornerRadius="99" Padding="10,2">
                            <TextBlock Text="{x:Bind Vm.FailCountText, Mode=OneWay}" Foreground="{ThemeResource ErrorTextBrush}" FontSize="12" />
                        </Border>
                        <Border Background="{ThemeResource InfoChipFillBrush}" CornerRadius="99" Padding="10,2"
                                Visibility="{x:Bind Vm.FixedChipVis, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Vm.FixedCountText, Mode=OneWay}" Foreground="{ThemeResource InfoTextBrush}" FontSize="12" />
                        </Border>
                    </StackPanel>
                </Grid>
                <ProgressBar Value="{x:Bind Vm.ProgressValue, Mode=OneWay}"
                             Maximum="{x:Bind Vm.ProgressMax, Mode=OneWay}"
                             IsIndeterminate="{x:Bind Vm.IsRunning, Mode=OneWay}" CornerRadius="2" />
                <TextBlock Text="{x:Bind Vm.SessionText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                           Visibility="{x:Bind Vm.SessionTextVis, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <!-- 实时测速卡（仅网速与低速分析模式显示） -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16,12,16,12"
                Visibility="{x:Bind Vm.HasSpeedCard, Mode=OneWay}">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Vm.SpeedMbpsText, Mode=OneWay}" FontSize="34" FontWeight="Bold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Mbps" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}"
                               VerticalAlignment="Bottom" Margin="0,0,0,9" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Vm.SpeedPhaseText, Mode=OneWay}" Style="{StaticResource BodyTextBlock}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind Vm.SpeedSubText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="下行带宽实测：多节点多连接限时下载；全程只读、不落盘、不上传。"
                               Style="{StaticResource CaptionTextBlock}" Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 低速原因分析卡 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="16,12,16,12"
                Visibility="{x:Bind Vm.HasSlowCauses, Mode=OneWay}">
            <StackPanel Spacing="6">
                <TextBlock Text="低速原因分析（按嫌疑度排序）" Style="{StaticResource SectionTitleTextBlock}" />
                <TextBlock Text="{x:Bind Vm.SlowConclusionText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}" />
                <ItemsControl ItemsSource="{x:Bind Vm.SlowCauses, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:SlowCause">
                            <Border Background="{ThemeResource HoverFillBrush}" CornerRadius="6" Padding="10,6" Margin="0,2">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{ThemeResource ErrorChipFillBrush}" CornerRadius="99" Padding="8,1"
                                                Visibility="{x:Bind IsHigh, Mode=OneTime}">
                                            <TextBlock Text="高嫌疑" Foreground="{ThemeResource ErrorTextBrush}" FontSize="10.5" />
                                        </Border>
                                        <Border Background="{ThemeResource WarningChipFillBrush}" CornerRadius="99" Padding="8,1"
                                                Visibility="{x:Bind IsMid, Mode=OneTime}">
                                            <TextBlock Text="可能" Foreground="{ThemeResource WarningTextBrush}" FontSize="10.5" />
                                        </Border>
                                        <Border Background="{ThemeResource InfoChipFillBrush}" CornerRadius="99" Padding="8,1"
                                                Visibility="{x:Bind IsLow, Mode=OneTime}">
                                            <TextBlock Text="轻微" Foreground="{ThemeResource InfoTextBrush}" FontSize="10.5" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CaptionTextBlock}" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind EvidenceText}" Style="{StaticResource CaptionTextBlock}"
                                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ActionText}" Style="{StaticResource CaptionTextBlock}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 检查结果列表 -->
        <ListView Grid.Row="4" ItemsSource="{x:Bind Vm.Items, Mode=OneWay}"
                  SelectionMode="None" IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,3" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:CheckItem">
                    <Border Style="{StaticResource CardStyle}" Padding="14,10,14,10">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextBlock}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Background="{ThemeResource InfoChipFillBrush}" CornerRadius="99" Padding="8,1">
                                        <TextBlock Text="{x:Bind CategoryText}" Foreground="{ThemeResource InfoTextBrush}" FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind DurationText, Mode=OneWay}" FontSize="11"
                                               Foreground="{ThemeResource PlaceholderTextBrush}" VerticalAlignment="Center" />
                                    <!-- 状态 Chip -->
                                    <Border Background="{ThemeResource SuccessChipFillBrush}" CornerRadius="99" Padding="10,2"
                                            Visibility="{x:Bind PassVis, Mode=OneWay}">
                                        <TextBlock Text="通过" Foreground="{ThemeResource SuccessTextBrush}" FontSize="11.5" />
                                    </Border>
                                    <Border Background="{ThemeResource WarningChipFillBrush}" CornerRadius="99" Padding="10,2"
                                            Visibility="{x:Bind WarnVis, Mode=OneWay}">
                                        <TextBlock Text="警告" Foreground="{ThemeResource WarningTextBrush}" FontSize="11.5" />
                                    </Border>
                                    <Border Background="{ThemeResource ErrorChipFillBrush}" CornerRadius="99" Padding="10,2"
                                            Visibility="{x:Bind FailVis, Mode=OneWay}">
                                        <TextBlock Text="未通过" Foreground="{ThemeResource ErrorTextBrush}" FontSize="11.5" />
                                    </Border>
                                    <Border Background="{ThemeResource InfoChipFillBrush}" CornerRadius="99" Padding="10,2"
                                            Visibility="{x:Bind FixedVis, Mode=OneWay}">
                                        <TextBlock Text="已修复" Foreground="{ThemeResource InfoTextBrush}" FontSize="11.5" />
                                    </Border>
                                    <Border Background="{ThemeResource CardBorderBrush}" CornerRadius="99" Padding="10,2"
                                            Visibility="{x:Bind SkippedVis, Mode=OneWay}">
                                        <TextBlock Text="跳过" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="11.5" />
                                    </Border>
                                    <Border Background="{ThemeResource InfoChipFillBrush}" CornerRadius="99" Padding="10,2"
                                            Visibility="{x:Bind RunningVis, Mode=OneWay}">
                                        <TextBlock Text="检查中…" Foreground="{ThemeResource InfoTextBrush}" FontSize="11.5" />
                                    </Border>
                                    <Border Background="{ThemeResource CardBorderBrush}" CornerRadius="99" Padding="10,2"
                                            Visibility="{x:Bind PendingVis, Mode=OneWay}">
                                        <TextBlock Text="待检查" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="11.5" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}" />
                            <Border Background="{ThemeResource HoverFillBrush}" CornerRadius="6" Padding="10,6"
                                    Visibility="{x:Bind SuggestionVis, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;" FontSize="13"
                                              Foreground="{ThemeResource InfoTextBrush}" />
                                    <TextBlock Text="{x:Bind Suggestion, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Expander Visibility="{x:Bind DetailsVis, Mode=OneWay}" HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left">
                                <Expander.Header>
                                    <TextBlock Text="详细信息" Style="{StaticResource CaptionTextBlock}" />
                                </Expander.Header>
                                <ItemsControl ItemsSource="{x:Bind Details, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}" Style="{StaticResource MonoTextBlock}"
                                                       Margin="0,2" IsTextSelectionEnabled="True" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 修复 + 导出 -->
        <Grid Grid.Row="5" ColumnSpacing="12" Height="236">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="一键修复（傻瓜模式）" Style="{StaticResource SectionTitleTextBlock}" />
                        <Button Content="修复所选" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right"
                                Command="{x:Bind Vm.FixSelectedCommand}"
                                IsEnabled="{x:Bind Vm.CanRepair, Mode=OneWay}" />
                    </Grid>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.RepairActions, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,2" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:RepairAction">
                                <Grid ColumnSpacing="8" Padding="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource CaptionTextBlock}"
                                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <Border Background="{ThemeResource WarningChipFillBrush}" CornerRadius="4" Padding="5,0"
                                                    Visibility="{x:Bind Risky, Mode=OneWay}">
                                                <TextBlock Text="需重启/谨慎" Foreground="{ThemeResource WarningTextBrush}" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlock}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind AdminText}" FontSize="10"
                                                   Foreground="{ThemeResource PlaceholderTextBrush}" VerticalAlignment="Center" />
                                        <Border Background="{ThemeResource SuccessChipFillBrush}" CornerRadius="4" Padding="6,1"
                                                Visibility="{x:Bind OkVis, Mode=OneWay}">
                                            <TextBlock Text="成功" Foreground="{ThemeResource SuccessTextBrush}" FontSize="10.5" />
                                        </Border>
                                        <Border Background="{ThemeResource ErrorChipFillBrush}" CornerRadius="4" Padding="6,1"
                                                Visibility="{x:Bind FailVis, Mode=OneWay}">
                                            <TextBlock Text="失败" Foreground="{ThemeResource ErrorTextBrush}" FontSize="10.5" />
                                        </Border>
                                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind RunningVis, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="2" Text="{x:Bind Vm.RepairHint, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="导出 PDF 诊断报告" Style="{StaticResource SectionTitleTextBlock}" />
                    <TextBlock Text="正规模板：含报告编号（按日累计）、设备编号与序列号、年级班级（生成时填写）、分层结果、修复记录与分级处置建议，适合上报与留档。"
                               Style="{StaticResource CaptionTextBlock}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="导出 PDF 报告" Style="{StaticResource AccentButtonStyle}"
                                Click="ExportPdf_Click" IsEnabled="{x:Bind Vm.HasRun, Mode=OneWay}" />
                        <Button Content="打开所在文件夹" IsEnabled="{x:Bind Vm.ReportReady, Mode=OneWay}"
                                Click="OpenReportFolder_Click" />
                    </StackPanel>
                    <InfoBar x:Name="ReportInfo" IsOpen="False" Severity="Success" IsClosable="True" />
                    <TextBlock Text="诊断日志按日期与次数分文件留存：" Style="{StaticResource CaptionTextBlock}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{x:Bind Vm.LogLocationText, Mode=OneWay}" Style="{StaticResource MonoTextBlock}"
                               IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
