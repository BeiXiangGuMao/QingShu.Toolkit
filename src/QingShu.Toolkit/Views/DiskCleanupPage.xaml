<Page
    x:Class="QingShu.Toolkit.Views.DiskCleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:QingShu.Toolkit.ViewModels">

    <Grid RowSpacing="12" Padding="28,20,28,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="磁盘清理" Style="{StaticResource PageTitleTextBlock}" />
            <TextBlock Text="常规安全清理 · 微信/QQ 久远文件询问式清理 · 全盘大文件兜底扫描。默认删除进回收站，可随时在设置中调整。"
                       Style="{StaticResource PageSubtitleTextBlock}" />
        </StackPanel>

        <!-- 标签页 -->
        <Grid Grid.Row="1">
            <Pivot>
                <!-- ============ 常规清理 ============ -->
                <PivotItem Header="常规清理">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.ScanRegularCommand}"
                                    IsEnabled="{x:Bind Vm.RegularReady, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Sync" /><TextBlock Text="开始扫描" />
                                </StackPanel>
                            </Button>
                            <Button Content="全选" Command="{x:Bind Vm.SelectAllRegularCommand}" />
                            <Button Content="全不选" Command="{x:Bind Vm.SelectNoneRegularCommand}" />
                            <Button Content="开始清理" Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind Vm.CleanRegularCommand}"
                                    IsEnabled="{x:Bind Vm.RegularReady, Mode=OneWay}" />
                            <ProgressBar Width="140" VerticalAlignment="Center" CornerRadius="2"
                                         IsIndeterminate="{x:Bind Vm.IsRegularBusy, Mode=OneWay}"
                                         Visibility="{x:Bind Vm.RegularBusyVis, Mode=OneWay}" />
                        </StackPanel>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.RegularTargets, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,2" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:CleanTargetVm">
                                    <Border Style="{StaticResource CardStyle}" Padding="12,8">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextBlock}" FontWeight="SemiBold" />
                                                    <Border Background="{ThemeResource InfoChipFillBrush}" CornerRadius="4" Padding="5,0">
                                                        <TextBlock Text="{x:Bind RiskText}" Foreground="{ThemeResource InfoTextBrush}" FontSize="10.5" />
                                                    </Border>
                                                    <Border Background="{ThemeResource WarningChipFillBrush}" CornerRadius="4" Padding="5,0"
                                                            Visibility="{x:Bind AdminVis, Mode=OneWay}">
                                                        <TextBlock Text="需管理员" Foreground="{ThemeResource WarningTextBrush}" FontSize="10.5" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlock}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" Style="{StaticResource BodyTextBlock}"
                                                           HorizontalAlignment="Right" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind FileText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                            <ProgressRing Grid.Column="3" Width="18" Height="18" VerticalAlignment="Center"
                                                          IsActive="{x:Bind IsScanning, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </PivotItem>

                <!-- ============ 微信 ============ -->
                <PivotItem Header="微信文件">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <InfoBar Severity="Warning" IsOpen="True" IsClosable="False" Title="清理前请阅读"
                                 Message="本工具绝不删除聊天记录数据库；但删除久远媒体文件后，对应历史聊天中的图片/视频将显示“图片已过期”。请确认后再勾选删除。" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                            <TextBox Header="久远阈值（天）" Text="{x:Bind Vm.ImOldDaysText, Mode=TwoWay}" Width="150" />
                            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.ScanWeChatCommand}"
                                    VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Sync" /><TextBlock Text="扫描微信" />
                                </StackPanel>
                            </Button>
                            <Button Content="全选" Command="{x:Bind Vm.SelectAllImCommand}" VerticalAlignment="Bottom" />
                            <Button Content="全不选" Command="{x:Bind Vm.SelectNoneImCommand}" VerticalAlignment="Bottom" />
                            <Button Content="删除所选" Command="{x:Bind Vm.DeleteImCommand}" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <Grid Grid.Row="2" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListView ItemsSource="{x:Bind Vm.WeChatFiles, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,1" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ImFileVm">
                                        <Border Style="{StaticResource CardStyle}" Padding="10,6">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" />
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource CaptionTextBlock}"
                                                                   Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                        <Border Background="{ThemeResource InfoChipFillBrush}" CornerRadius="4" Padding="5,0">
                                                            <TextBlock Text="{x:Bind KindText}" Foreground="{ThemeResource InfoTextBrush}" FontSize="10" />
                                                        </Border>
                                                        <TextBlock Text="{x:Bind AccountText}" FontSize="10.5"
                                                                   Foreground="{ThemeResource PlaceholderTextBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind PathText}" Style="{StaticResource MonoTextBlock}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind TimeText}" Style="{StaticResource CaptionTextBlock}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" Style="{StaticResource BodyTextBlock}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="{x:Bind Vm.ImSelectedText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                                           FontWeight="SemiBold" Foreground="{ThemeResource InfoTextBrush}" />
                                <TextBlock Text="{x:Bind Vm.WeChatStatus, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}" />
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsWeChatBusy, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </PivotItem>

                <!-- ============ QQ ============ -->
                <PivotItem Header="QQ文件">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                                 Message="扫描 Tencent Files（含 FileRecv 接收文件、图片、视频、表情缓存与新版 nt_qq 数据），仅列出超过阈值天数的文件。数据库文件受保护不会被列出或删除。" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                            <TextBox Header="久远阈值（天）" Text="{x:Bind Vm.ImOldDaysText, Mode=TwoWay}" Width="150" />
                            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.ScanQqCommand}" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Sync" /><TextBlock Text="扫描 QQ" />
                                </StackPanel>
                            </Button>
                            <Button Content="全选" Command="{x:Bind Vm.SelectAllImCommand}" VerticalAlignment="Bottom" />
                            <Button Content="全不选" Command="{x:Bind Vm.SelectNoneImCommand}" VerticalAlignment="Bottom" />
                            <Button Content="删除所选" Command="{x:Bind Vm.DeleteImCommand}" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <Grid Grid.Row="2" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListView ItemsSource="{x:Bind Vm.QqFiles, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,1" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ImFileVm">
                                        <Border Style="{StaticResource CardStyle}" Padding="10,6">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" />
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource CaptionTextBlock}"
                                                                   Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                        <Border Background="{ThemeResource InfoChipFillBrush}" CornerRadius="4" Padding="5,0">
                                                            <TextBlock Text="{x:Bind KindText}" Foreground="{ThemeResource InfoTextBrush}" FontSize="10" />
                                                        </Border>
                                                        <TextBlock Text="{x:Bind AccountText}" FontSize="10.5"
                                                                   Foreground="{ThemeResource PlaceholderTextBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind PathText}" Style="{StaticResource MonoTextBlock}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind TimeText}" Style="{StaticResource CaptionTextBlock}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" Style="{StaticResource BodyTextBlock}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="{x:Bind Vm.ImSelectedText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                                           FontWeight="SemiBold" Foreground="{ThemeResource InfoTextBrush}" />
                                <TextBlock Text="{x:Bind Vm.QqStatus, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}" />
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsQqBusy, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </PivotItem>

                <!-- ============ 大文件 ============ -->
                <PivotItem Header="大文件">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ComboBox Header="扫描分区" SelectedIndex="{x:Bind Vm.DriveIndex, Mode=TwoWay}" MinWidth="120"
                                      ItemsSource="{x:Bind Vm.Drives, Mode=OneWay}" />
                            <TextBox Header="大小阈值（MB）" Text="{x:Bind Vm.LargeMinMbText, Mode=TwoWay}" Width="150" />
                            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.ScanLargeCommand}" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Sync" /><TextBlock Text="开始扫描" />
                                </StackPanel>
                            </Button>
                            <Button Content="打开位置" Click="OpenLargeFolder_Click" VerticalAlignment="Bottom" />
                            <Button Content="删除所选" Command="{x:Bind Vm.DeleteLargeCommand}" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <Grid Grid.Row="1" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListView ItemsSource="{x:Bind Vm.LargeFiles, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0,1" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LargeFileVm">
                                        <Border Style="{StaticResource CardStyle}" Padding="10,6">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" />
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource CaptionTextBlock}"
                                                               Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind PathText}" Style="{StaticResource MonoTextBlock}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind TimeText}" Style="{StaticResource CaptionTextBlock}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind SizeText}" Style="{StaticResource BodyTextBlock}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="{x:Bind Vm.LargeSelectedText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                                           FontWeight="SemiBold" Foreground="{ThemeResource InfoTextBrush}" />
                                <TextBlock Text="{x:Bind Vm.LargeStatus, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}" />
                                <ProgressRing Width="16" Height="16" IsActive="{x:Bind Vm.IsLargeBusy, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </PivotItem>
            </Pivot>
        </Grid>

        <!-- 底部状态 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14,8">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ToggleSwitch Header="" OnContent="删除进回收站" OffContent="直接删除"
                                  IsOn="{x:Bind Vm.DeleteToRecycleBin, Mode=TwoWay}" Margin="-8,0,0,0" />
                    <TextBlock Text="{x:Bind Vm.LastResult, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="安全边界：不修改系统服务 / 不动虚拟内存 / 不导入注册表 / 不关闭 Defender"
                           Style="{StaticResource CaptionTextBlock}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>
