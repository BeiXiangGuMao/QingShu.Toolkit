<Page
    x:Class="QingShu.Toolkit.Views.OptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:QingShu.Toolkit.ViewModels">

    <ScrollViewer Padding="28,20,28,20">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch" Spacing="14">
            <StackPanel.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="12" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </StackPanel.Transitions>

            <StackPanel>
                <TextBlock Text="性能优化" Style="{StaticResource PageTitleTextBlock}" />
                <TextBlock Text="只做安全且可逆的优化，按影响范围分为应用级与系统级两档。绝不触碰服务/虚拟内存/注册表/Defender。"
                           Style="{StaticResource PageSubtitleTextBlock}" />
            </StackPanel>

            <!-- ============ 应用级优化 ============ -->
            <StackPanel Spacing="2">
                <TextBlock Text="应用级优化 —— 只影响所选进程，全部可逆" Style="{StaticResource SectionTitleTextBlock}" />
                <TextBlock Text="针对单个程序的内存与功耗动作；系统关键组件已标注并在引擎内受保护。" Style="{StaticResource CaptionTextBlock}" />
            </StackPanel>

            <!-- 内存整理 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="内存整理（不结束进程）" Style="{StaticResource SectionTitleTextBlock}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Command="{x:Bind Vm.RefreshMemoryCommand}" IsEnabled="{x:Bind Vm.MemoryReady, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Sync" /><TextBlock Text="刷新" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.TrimMemoryCommand}"
                                    IsEnabled="{x:Bind Vm.MemoryReady, Mode=OneWay}" Content="整理所选内存" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="EmptyWorkingSet 原理：把进程的物理内存页回收进待用列表，进程继续正常运行，等价于系统自带的内存压缩策略。"
                               Style="{StaticResource CaptionTextBlock}" />
                    <ListView ItemsSource="{x:Bind Vm.MemoryProcesses, Mode=OneWay}" SelectionMode="None" MaxHeight="300">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,1" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProcessRowVm">
                                <Grid ColumnSpacing="10" Padding="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextBlock}" />
                                            <Border Background="{ThemeResource WarningChipFillBrush}" CornerRadius="4" Padding="5,0"
                                                    Visibility="{x:Bind IsSystem}">
                                                <TextBlock Text="系统组件" Foreground="{ThemeResource WarningTextBrush}" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Purpose}" Style="{StaticResource CaptionTextBlock}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind PidText}" Style="{StaticResource MonoTextBlock}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind WsText}" Style="{StaticResource BodyTextBlock}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{x:Bind Vm.MemoryResult, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                               Foreground="{ThemeResource InfoTextBrush}" />
                </StackPanel>
            </Border>

            <!-- 进程 EcoQoS -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="进程节能（EcoQoS 功耗遏制）" Style="{StaticResource SectionTitleTextBlock}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Command="{x:Bind Vm.ApplyEcoCommand}" IsEnabled="{x:Bind Vm.EcoReady, Mode=OneWay}" Content="对所选启用节能" />
                            <Button Command="{x:Bind Vm.RestoreEcoCommand}" IsEnabled="{x:Bind Vm.EcoReady, Mode=OneWay}" Content="恢复调度" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="EcoQoS 让闲置后台进程运行在能效核/低频档（Win10 1709+），适合在完成后台的更新、同步类任务上使用。"
                               Style="{StaticResource CaptionTextBlock}" />
                    <ListView ItemsSource="{x:Bind Vm.EcoProcesses, Mode=OneWay}" SelectionMode="None" MaxHeight="240">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,1" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProcessRowVm">
                                <Grid ColumnSpacing="10" Padding="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextBlock}" />
                                            <Border Background="{ThemeResource WarningChipFillBrush}" CornerRadius="4" Padding="5,0"
                                                    Visibility="{x:Bind IsSystem}">
                                                <TextBlock Text="系统组件" Foreground="{ThemeResource WarningTextBrush}" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Purpose}" Style="{StaticResource CaptionTextBlock}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{ThemeResource SuccessChipFillBrush}" CornerRadius="4" Padding="6,1"
                                            Visibility="{x:Bind EcoVis, Mode=OneWay}">
                                        <TextBlock Text="EcoQoS" Foreground="{ThemeResource SuccessTextBrush}" FontSize="10" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{x:Bind WsText}" Style="{StaticResource BodyTextBlock}"
                                               VerticalAlignment="Center" Margin="14,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{x:Bind Vm.EcoResult, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                               Foreground="{ThemeResource InfoTextBrush}" />
                </StackPanel>
            </Border>

            <!-- ============ 系统级优化 ============ -->
            <StackPanel Spacing="2">
                <TextBlock Text="系统级优化 —— 影响整机行为，逐项确认" Style="{StaticResource SectionTitleTextBlock}" />
                <TextBlock Text="启动项影响开机加载，支持应用内禁用/启用（可逆）。弹窗拦截已拆分为独立页面（左侧导航「弹窗拦截」）。均不修改系统服务/Defender。"
                           Style="{StaticResource CaptionTextBlock}" />
            </StackPanel>

            <!-- 启动项管理 -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="启动项管理" Style="{StaticResource SectionTitleTextBlock}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Command="{x:Bind Vm.RefreshStartupCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Sync" /><TextBlock Text="刷新" /></StackPanel>
                            </Button>
                            <Button Command="{x:Bind Vm.OpenTaskManagerCommand}" Content="打开任务管理器" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{x:Bind Vm.StartupHint, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind Vm.StartupResult, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                               Foreground="{ThemeResource InfoTextBrush}"
                               Visibility="{x:Bind Vm.HasStartupResult, Mode=OneWay}" />
                    <ListView ItemsSource="{x:Bind Vm.StartupItems, Mode=OneWay}" SelectionMode="None" MaxHeight="260">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,2" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:StartupRowVm">
                                <Border Background="{ThemeResource CardBackgroundBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,7">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextBlock}"
                                                       TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Source}" Style="{StaticResource CaptionTextBlock}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Command}" Style="{StaticResource MonoTextBlock}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.75" />
                                        <Border Grid.Column="2" Background="{ThemeResource SuccessChipFillBrush}" CornerRadius="4" Padding="7,1"
                                                Visibility="{x:Bind EnabledVis}" VerticalAlignment="Center">
                                            <TextBlock Text="已启用" Foreground="{ThemeResource SuccessTextBrush}" FontSize="10" />
                                        </Border>
                                        <Border Grid.Column="2" Background="{ThemeResource InfoChipFillBrush}" CornerRadius="4" Padding="7,1"
                                                Visibility="{x:Bind DisabledVis}" VerticalAlignment="Center">
                                            <TextBlock Text="已禁用" Foreground="{ThemeResource InfoTextBrush}" FontSize="10" />
                                        </Border>
                                        <Button Grid.Column="3" Command="{x:Bind Owner.ToggleStartupCommand}"
                                                CommandParameter="{x:Bind}"
                                                Content="{x:Bind ToggleText}"
                                                Padding="12,3" MinHeight="0" VerticalAlignment="Center"
                                                ToolTipService.ToolTip="禁用前自动备份，可随时恢复" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- 边界声明 -->
            <InfoBar Severity="Informational" IsOpen="True" IsClosable="False" Title="青枢工具箱的设计边界"
                     Message="本工具承诺：不改 services.msc 服务、不改虚拟内存、不导入注册表文件、不做 NTLite 式精简、不内置一键优化全家桶、不关闭 Defender。所有优化均可逆、可解释、可回溯（全部写入日志）。" />
        </StackPanel>
    </ScrollViewer>
</Page>
