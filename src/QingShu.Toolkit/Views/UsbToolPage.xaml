<Page
    x:Class="QingShu.Toolkit.Views.UsbToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:QingShu.Toolkit.ViewModels"
    xmlns:us="using:QingShu.Toolkit.Services.Usb">

    <Grid RowSpacing="10" Padding="28,20,28,12">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="12" IsStaggeringEnabled="True" />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="U盘工具" Style="{StaticResource PageTitleTextBlock}" />
            <TextBlock Text="修复与查杀二合一，直连物理盘扇区做硬件级检测：表面坏区扫描、扩容盘鉴别、写速度实测；查杀覆盖U盘蠕虫的 autorun 自启、伪装文档、快捷方式劫持等落盘特征；修复提供设备栈重置、文件系统查错到分区表重建。只对 USB 设备生效，绝不触碰系统盘。"
                       Style="{StaticResource PageSubtitleTextBlock}" MaxWidth="860" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- 设备选择卡 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6" MinWidth="430">
                    <ComboBox x:Name="DeviceCombo" ItemsSource="{x:Bind Vm.Devices, Mode=OneWay}"
                              SelectedItem="{x:Bind Vm.SelectedDevice, Mode=TwoWay}"
                              DisplayMemberPath="Summary" MinWidth="400" MaxWidth="560"
                              HorizontalAlignment="Stretch" IsEnabled="{x:Bind Vm.IsNotBusy, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind Vm.RefreshDevicesCommand}" IsEnabled="{x:Bind Vm.IsNotBusy, Mode=OneWay}"
                                Padding="14,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Refresh" /><TextBlock Text="刷新设备" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind Vm.RunHealthCommand}" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" Padding="14,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Repair" /><TextBlock Text="健康检测（只读，1-2分钟）" />
                            </StackPanel>
                        </Button>
                        <Button Click="CapacityTest_Click" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}"
                                Padding="14,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="ReportHacked" /><TextBlock Text="扩容盘检测（破坏性）" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2" VerticalAlignment="Top"
                            Visibility="{x:Bind Vm.HasDevice, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Vm.SelectedDevice.Summary, Mode=OneWay}" Style="{StaticResource BodyTextBlock}" />
                    <TextBlock Text="{x:Bind Vm.SelectedDevice.BusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Vm.SelectedDevice.SerialText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Vm.SelectedDevice.VolumesText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                               Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="430" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="无设备时说明：未识别到 USBSTOR 设备。手机 MTP 模式不是U盘，需以「U盘模式/文件传输」或读卡器接入；部分劣质读卡器不在支持范围。"
                           Style="{StaticResource CaptionTextBlock}" Foreground="{ThemeResource PlaceholderTextBrush}"
                           VerticalAlignment="Top" TextWrapping="Wrap"
                           Visibility="{x:Bind Vm.IsEmptyResult, Mode=OneWay}" />
            </Grid>
        </Border>

        <!-- 进度 -->
        <Grid Grid.Row="2" ColumnSpacing="10" Visibility="{x:Bind Vm.IsBusy, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressRing Width="18" Height="18" IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" />
            <TextBlock Grid.Column="1" Text="{x:Bind Vm.ProgressText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="取消操作" Command="{x:Bind Vm.CancelOperationCommand}"
                    Padding="12,4" VerticalAlignment="Center" />
        </Grid>

        <!-- 双卡：检测与修复 | 查杀 -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左卡：检测结论 + 修复动作 -->
            <Border Style="{StaticResource CardStyle}" Padding="14">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="检测结论与修复" Style="{StaticResource SectionTitleTextBlock}" />
                    <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.CheckResults, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,2" /><Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:UsbCheckRow">
                                <StackPanel Spacing="1" Padding="2,3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{ThemeResource SuccessChipFillBrush}" CornerRadius="4" Padding="6,1"
                                                Visibility="{x:Bind PassVis, Mode=OneWay}">
                                            <TextBlock Text="正常" Foreground="{ThemeResource SuccessTextBrush}" FontSize="10.5" />
                                        </Border>
                                        <Border Background="{ThemeResource WarningChipFillBrush}" CornerRadius="4" Padding="6,1"
                                                Visibility="{x:Bind WarnVis, Mode=OneWay}">
                                            <TextBlock Text="注意" Foreground="{ThemeResource WarningTextBrush}" FontSize="10.5" />
                                        </Border>
                                        <Border Background="{ThemeResource ErrorChipFillBrush}" CornerRadius="4" Padding="6,1"
                                                Visibility="{x:Bind FailVis, Mode=OneWay}">
                                            <TextBlock Text="异常" Foreground="{ThemeResource ErrorTextBrush}" FontSize="10.5" />
                                        </Border>
                                        <Border Background="{ThemeResource InfoChipFillBrush}" CornerRadius="4" Padding="6,1"
                                                Visibility="{x:Bind SkipVis, Mode=OneWay}">
                                            <TextBlock Text="跳过" Foreground="{ThemeResource InfoTextBrush}" FontSize="10.5" />
                                        </Border>
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CaptionTextBlock}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Suggestion}" Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                               Visibility="{x:Bind SuggestionVis, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlock}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource PlaceholderTextBrush}"
                                               Visibility="{x:Bind DetailsVis, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="2" Text="修复动作（管理类合并为一次 UAC；不会触碰系统盘）" Style="{StaticResource CaptionTextBlock}"
                               Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    <ListView Grid.Row="3" ItemsSource="{x:Bind Vm.FixActions, Mode=OneWay}" SelectionMode="None" MaxHeight="150">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,2" /><Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="us:UsbFixAction">
                                <Grid ColumnSpacing="8" Padding="2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource CaptionTextBlock}"
                                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <Border Background="{ThemeResource WarningChipFillBrush}" CornerRadius="4" Padding="5,0"
                                                    Visibility="{x:Bind Risky, Mode=OneWay}">
                                                <TextBlock Text="清空数据" Foreground="{ThemeResource WarningTextBrush}" FontSize="10" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlock}"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind AdminText}" FontSize="10"
                                                   Foreground="{ThemeResource PlaceholderTextBrush}" VerticalAlignment="Center" />
                                        <Border Background="{ThemeResource SuccessChipFillBrush}" CornerRadius="4" Padding="6,1"
                                                Visibility="{x:Bind OkVis, Mode=OneWay}">
                                            <TextBlock Text="成功" Foreground="{ThemeResource SuccessTextBrush}" FontSize="10.5" />
                                        </Border>
                                        <Border Background="{ThemeResource ErrorChipFillBrush}" CornerRadius="4" Padding="6,1"
                                                Visibility="{x:Bind FailVis, Mode=OneWay}">
                                            <TextBlock Text="失败" Foreground="{ThemeResource ErrorTextBrush}" FontSize="10.5" />
                                        </Border>
                                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind RunningVis, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Command="{x:Bind Vm.FixSelectedCommand}" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" Padding="16,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Play" /><TextBlock Text="修复所选" />
                            </StackPanel>
                        </Button>
                        <Button Click="Rebuild_Click" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}" Padding="14,6">
                            <TextBlock Text="格式化重建（高级）" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右卡：查杀 -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="U盘查杀（蠕虫落盘特征 · 离线扫描）" Style="{StaticResource SectionTitleTextBlock}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind Vm.RunScanCommand}" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" Padding="14,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Find" /><TextBlock Text="开始查杀" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind Vm.QuarantineSelectedCommand}" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}"
                                Padding="12,5">
                            <TextBlock Text="隔离所选" />
                        </Button>
                        <Button Command="{x:Bind Vm.UnhideCommand}" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}" Padding="12,5">
                            <TextBlock Text="解除隐藏" />
                        </Button>
                        <Button Command="{x:Bind Vm.ImmuneCommand}" IsEnabled="{x:Bind Vm.CanOperate, Mode=OneWay}" Padding="12,5">
                            <TextBlock Text="U盘免疫" />
                        </Button>
                    </StackPanel>
                    <ListView Grid.Row="2" ItemsSource="{x:Bind Vm.Threats, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0,2" /><Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:UsbThreatRow">
                                <Grid ColumnSpacing="8" Padding="2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{ThemeResource ErrorChipFillBrush}" CornerRadius="4" Padding="5,0"
                                                    Visibility="{x:Bind MalVis, Mode=OneWay}">
                                                <TextBlock Text="恶意" Foreground="{ThemeResource ErrorTextBrush}" FontSize="10" />
                                            </Border>
                                            <Border Background="{ThemeResource WarningChipFillBrush}" CornerRadius="4" Padding="5,0"
                                                    Visibility="{x:Bind SuspVis, Mode=OneWay}">
                                                <TextBlock Text="可疑" Foreground="{ThemeResource WarningTextBrush}" FontSize="10" />
                                            </Border>
                                            <TextBlock Text="{x:Bind FileName}" Style="{StaticResource CaptionTextBlock}"
                                                       Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CaptionTextBlock}"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlock}"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind FilePath}" Style="{StaticResource CaptionTextBlock}" FontSize="10"
                                                   Foreground="{ThemeResource PlaceholderTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="3" Text="{x:Bind Vm.ThreatSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
