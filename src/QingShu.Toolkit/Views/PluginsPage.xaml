<Page
    x:Class="QingShu.Toolkit.Views.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:QingShu.Toolkit.ViewModels">

    <Grid RowSpacing="10" Padding="28,20,28,12">
        <Grid.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="12" IsStaggeringEnabled="True" />
            </TransitionCollection>
        </Grid.Transitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="插件管理" Style="{StaticResource PageTitleTextBlock}" />
            <TextBlock Text="插件化功能体系：内置功能（网络诊断、磁盘清理、U盘工具等）已作为默认插件预装，可在下方启停；外置插件目录（上方路径）中的插件无需签名即可加载，官方签名为可选增强——提供 plugin.sig 的目录会做完整验签，验签不符仍会拒绝（防篡改）。声明 releases 权限的插件可查询与下载仓库 Release。"
                       Style="{StaticResource PageSubtitleTextBlock}" MaxWidth="860" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- 工具条 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind Vm.ScanCommand}" IsEnabled="{x:Bind Vm.IsNotBusy, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}" Padding="14,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Refresh" /><TextBlock Text="重新扫描" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind Vm.LoadEnabledCommand}" IsEnabled="{x:Bind Vm.IsNotBusy, Mode=OneWay}"
                            Padding="14,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Play" /><TextBlock Text="加载全部启用项" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind Vm.OpenFolderCommand}" Padding="14,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Folder" /><TextBlock Text="打开插件目录" />
                        </StackPanel>
                    </Button>
                    <ProgressRing Width="18" Height="18" IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}"
                                  VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="插件目录" Style="{StaticResource CaptionTextBlock}"
                               Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Vm.PluginsRoot, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                               Foreground="{ThemeResource PlaceholderTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="官方签名指纹（可选校验）" Style="{StaticResource CaptionTextBlock}"
                               Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Vm.KeyFingerprint, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                               Foreground="{ThemeResource PlaceholderTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind Vm.StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                               Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 插件自绘面板挂载区 -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14"
                Visibility="{x:Bind Vm.PanelOpenVis, Mode=OneWay}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{x:Bind Vm.PanelTitle, Mode=OneWay}" Style="{StaticResource SectionTitleTextBlock}" />
                    <TextBlock Text="关闭面板不影响插件后台运行；卸载插件前面板会自动收起。"
                               Style="{StaticResource CaptionTextBlock}" Foreground="{ThemeResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Content="收起面板" Click="ClosePanelClick" Padding="12,4" VerticalAlignment="Center" />
                </StackPanel>
                <ContentControl Grid.Row="1" Content="{x:Bind Vm.PanelContent, Mode=OneWay}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                MinHeight="480" />
            </Grid>
        </Border>

        <!-- 插件列表：内置功能（默认插件）+ 外置插件 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="14">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="内置功能（默认插件 · 默认安装）" Style="{StaticResource SectionTitleTextBlock}" />
                <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.BuiltIns, Mode=OneWay}" SelectionMode="None" MaxHeight="300">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,2" /><Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BuiltInPluginVm">
                            <Grid Padding="2,10" ColumnSpacing="14" BorderThickness="0,0,0,1"
                                  BorderBrush="{ThemeResource DividerStrokeBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyTextBlock}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind VersionText}" Style="{StaticResource CaptionTextBlock}"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Border Background="{ThemeResource InfoChipFillBrush}" CornerRadius="4" Padding="6,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="内置 · 默认安装" Foreground="{ThemeResource InfoTextBrush}" FontSize="10.5" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlock}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind MetaText}" Style="{StaticResource CaptionTextBlock}"
                                               Foreground="{ThemeResource PlaceholderTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <CheckBox Content="启用" MinWidth="0" IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" />
                                    <Button Content="打开" Command="{x:Bind OpenCommand}" Padding="14,5" MinWidth="86"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Visibility="{x:Bind OpenVis, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="2" Text="外置插件（plugins 目录）" Style="{StaticResource SectionTitleTextBlock}" Margin="0,8,0,0" />
                <TextBlock Grid.Row="3" Text="插件目录为空。把插件目录放入上面路径后点「重新扫描」即可加载（无需签名；开发方法见仓库 plugins-sdk/README.md）。"
                           Style="{StaticResource CaptionTextBlock}" Foreground="{ThemeResource PlaceholderTextBrush}"
                           TextWrapping="Wrap" Visibility="{x:Bind Vm.EmptyVis, Mode=OneWay}" />
                <ListView Grid.Row="3" ItemsSource="{x:Bind Vm.Plugins, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0,2" /><Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PluginItemVm">
                            <Grid Padding="2,10" ColumnSpacing="14" BorderThickness="0,0,0,1"
                                  BorderBrush="{ThemeResource DividerStrokeBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource BodyTextBlock}"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind VersionText}" Style="{StaticResource CaptionTextBlock}"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Border Background="{ThemeResource SuccessChipFillBrush}" CornerRadius="4" Padding="6,1"
                                                VerticalAlignment="Center" Visibility="{x:Bind VerifyOkVis, Mode=OneWay}">
                                            <TextBlock Text="官方签名" Foreground="{ThemeResource SuccessTextBrush}" FontSize="10.5" />
                                        </Border>
                                        <Border Background="{ThemeResource ErrorChipFillBrush}" CornerRadius="4" Padding="6,1"
                                                VerticalAlignment="Center" Visibility="{x:Bind VerifyBadVis, Mode=OneWay}">
                                            <TextBlock Text="验签未过" Foreground="{ThemeResource ErrorTextBrush}" FontSize="10.5" />
                                        </Border>
                                        <Border Background="{ThemeResource InfoChipFillBrush}" CornerRadius="4" Padding="6,1"
                                                VerticalAlignment="Center" Visibility="{x:Bind VerifyUnsignedVis, Mode=OneWay}">
                                            <TextBlock Text="未签名 · 可加载" Foreground="{ThemeResource InfoTextBrush}" FontSize="10.5" />
                                        </Border>
                                        <Border Background="{ThemeResource SuccessChipFillBrush}" CornerRadius="4" Padding="6,1"
                                                VerticalAlignment="Center" Visibility="{x:Bind LoadedVis, Mode=OneWay}">
                                            <TextBlock Text="运行中" Foreground="{ThemeResource SuccessTextBrush}" FontSize="10.5" />
                                        </Border>
                                        <Border Background="{ThemeResource InfoChipFillBrush}" CornerRadius="4" Padding="6,1"
                                                VerticalAlignment="Center" Visibility="{x:Bind UnloadedVis, Mode=OneWay}">
                                            <TextBlock Text="未加载" Foreground="{ThemeResource InfoTextBrush}" FontSize="10.5" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind MetaText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Description}" Style="{StaticResource CaptionTextBlock}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind PermissionsText}" Style="{StaticResource CaptionTextBlock}"
                                               Foreground="{ThemeResource PlaceholderTextBrush}" />
                                    <ItemsControl ItemsSource="{x:Bind QuickActions, Mode=OneWay}" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:QuickActionVm">
                                                <StackPanel Spacing="2">
                                                    <Button Command="{x:Bind RunCommand}" IsEnabled="{x:Bind NotRunning, Mode=OneWay}"
                                                            Padding="12,4">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE768;"
                                                                      FontSize="12" />
                                                            <TextBlock Text="{x:Bind Name}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBlock Text="{x:Bind LastText, Mode=OneWay}" FontSize="10.5"
                                                               Foreground="{ThemeResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap" MaxWidth="420"
                                                               Visibility="{x:Bind HasLastText, Mode=OneWay}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{x:Bind RuntimeText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                                               Foreground="{ThemeResource SuccessTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="{x:Bind HasRuntime, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ErrorText, Mode=OneWay}" Style="{StaticResource CaptionTextBlock}"
                                               Foreground="{ThemeResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                               Visibility="{x:Bind HasError, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <CheckBox Content="启用" MinWidth="0" IsChecked="{x:Bind IsEnabled, Mode=TwoWay}" />
                                    <Button Content="加载" Command="{x:Bind LoadCommand}" Padding="14,5" MinWidth="86"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Visibility="{x:Bind CanLoad, Mode=OneWay}" />
                                    <Button Content="面板" Command="{x:Bind PanelCommand}" Padding="14,5" MinWidth="86"
                                            Visibility="{x:Bind HasPanel, Mode=OneWay}" />
                                    <Button Content="卸载" Command="{x:Bind UnloadCommand}" Padding="14,5" MinWidth="86"
                                            Visibility="{x:Bind CanUnload, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
