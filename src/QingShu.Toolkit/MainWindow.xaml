<Window
    x:Class="QingShu.Toolkit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QingShu.Toolkit.Views">

    <Grid x:Name="RootGrid" Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 自定义标题栏 ================= -->
        <Grid Grid.Row="0" Height="48">
            <!-- 左侧：Logo + 标题（拖拽区） -->
            <Grid x:Name="TitleDragArea" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="10">
                    <Border Width="26" Height="26" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0A84FF" Offset="0" />
                                <GradientStop Color="#409CFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="枢" Foreground="White" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="青枢工具箱" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                        <TextBlock Text="QingShu.Toolkit" FontSize="11"
                                   Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 右侧：手动更新按钮（位于最小化按钮左侧的标题栏区域） -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,152,0" Spacing="6">
                <Button x:Name="BtnUpdate"
                        Width="34" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="5"
                        Click="BtnUpdate_Click"
                        ToolTipService.ToolTip="检查更新">
                    <Grid>
                        <FontIcon x:Name="UpdateIcon" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE895;"
                                  FontSize="14" Foreground="{ThemeResource TextSecondaryBrush}" />
                        <ProgressRing x:Name="UpdateRing" Width="16" Height="16" IsActive="False" />
                        <Ellipse x:Name="UpdateDot" Width="7" Height="7" Fill="{ThemeResource ErrorBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"
                                 Visibility="Collapsed" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= 导航 ================= -->
        <NavigationView x:Name="NavView" Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="216"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <!-- 底色统一：窗格/内容区透明，露出统一的页面底色，消除深浅色模式下
                         系统默认灰白块与自定义色板的拼接感 -->
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="dashboard" Content="总览仪表盘">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="network" Content="网络诊断">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="cleanup" Content="磁盘清理">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Delete" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="optimize" Content="性能优化">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="logs" Content="日志查看">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="settings" Content="设置">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" />
            </Grid>
        </NavigationView>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Height="32"
                Background="{ThemeResource CardBackgroundBrush}"
                BorderBrush="{ThemeResource DividerStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0,14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="青枢工具箱" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock x:Name="VersionText" FontSize="11" Foreground="{ThemeResource PlaceholderTextBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="16">
                    <!-- 弹窗拦截计数（点击打开白名单管理） -->
                    <Button x:Name="BtnWhitelist"
                            Background="Transparent" BorderThickness="0" CornerRadius="5" Padding="8,3"
                            VerticalAlignment="Center"
                            Click="BtnWhitelist_Click"
                            ToolTipService.ToolTip="弹窗拦截：白名单与最近拦截记录">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE720;" FontSize="12"
                                      Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock x:Name="PopupCountText" Text="拦截 0" FontSize="11"
                                       Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- 功耗三色小标识 -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse x:Name="PowerDot" Width="9" Height="9" Fill="{ThemeResource PowerBalancedBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="PowerText" Text="平衡" FontSize="11"
                                   Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
