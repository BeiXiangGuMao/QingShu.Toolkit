<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>QingShu.Toolkit</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <!--
      Windows SDK 投影版本覆盖（CsWinRT 2.3.1 官方尾号规则：.86 = .NET 8，.87 = .NET 9/10）：
      - TFM 默认解析出 10.0.19041.54（WinRT.Runtime 2.1.x），
      - CommunityToolkit.Mvvm 8.4.2 要求 >= 10.0.19041.56（NU1605/CS 报错），
      - WindowsAppSDK 1.6 要求 >= 10.0.22621.38（官方 release notes），
      - .87 尾号投影内嵌 WinRT.Runtime 2.3.1.0 针对 .NET 9（System.Runtime 9.0.0.0），
        在 net8.0 下报 CS1705 —— 必须用 .86 尾号（同一投影的 .NET 8 目标版本）。
    -->
    <WindowsSdkPackageVersion>10.0.26100.86</WindowsSdkPackageVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!--
      双模式打包说明（详见 docs/BUILD.md）：
      - 未打包 exe（默认）：保持下方 WindowsPackageType=None
      - MSIX 安装包：将 None 改为 MSIX，并取消注释下方 ItemGroup 中的 Package.appxmanifest
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!--
      MVVM Toolkit 风格提示关闭：[ObservableProperty] 保持经典字段式写法。
      C# 13 分部属性写法（public partial T Xxx { get; set; }）在部分 VS/Roslyn 组合下
      生成器不产出实现，导致 CS9248/CS0759 全量报错（8661fe8 已全量回退），
      故固定字段式并屏蔽对应风格诊断，避免再次被误导迁移。
    -->
    <NoWarn>$(NoWarn);MVVMTK0045;MVVMTK0034</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!--
      版本策略（Beta 阶段）：展示版本带 -beta 后缀（经 InformationalVersion 自动进入 AppVersion.DisplayText），
      程序集数字版本自动取前缀 1.2.0，更新比较 Version.Parse(AppVersion.Text) 不受影响。
      转正时改为如 <Version>1.3.0</Version> 即可，展示后缀自动消失。
    -->
    <Version>1.2.0-beta</Version>
    <Copyright>版权所有 © 2026 BeiXiangGuMao</Copyright>
    <AssemblyName>QingShu.Toolkit</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Authors>BeiXiangGuMao</Authors>
    <Product>青枢工具箱 QingShu.Toolkit</Product>
    <Description>学校专用系统工具箱：网络诊断 / 磁盘清理 / 性能优化 / 功耗管理</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- MSIX 双模式：切换为 MSIX 打包时取消注释
  <ItemGroup>
    <AppxManifest Include="..\..\packaging\Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>
  -->

</Project>
