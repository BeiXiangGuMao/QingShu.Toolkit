<!--
  青枢工具箱 · 全局色板（品牌 / 语义 / 功耗标识）
  规范：现代系统级中性色板 —— 克制的灰阶中性底 + 单一强调蓝 + 配套可访问性状态文字变体
  浅色强调 #007AFF，深色强调 #0A84FF（提亮防发灰）
  状态文字使用深/浅变体（SuccessText 等），保持 WCAG AA
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ================= 浅色模式 ================= -->
        <ResourceDictionary x:Key="Light">

            <!-- 系统强调色覆写（按钮/滑块等原生控件自动生效） -->
            <Color x:Key="SystemAccentColor">#007AFF</Color>
            <Color x:Key="SystemAccentColorLight1">#4DA3FF</Color>
            <Color x:Key="SystemAccentColorLight2">#80BDFF</Color>
            <Color x:Key="SystemAccentColorLight3">#B3D7FF</Color>
            <Color x:Key="SystemAccentColorDark1">#0062CC</Color>
            <Color x:Key="SystemAccentColorDark2">#004C9E</Color>
            <Color x:Key="SystemAccentColorDark3">#00376F</Color>

            <!-- 品牌 -->
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#007AFF" />
            <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#3395FF" />
            <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="#0062CC" />

            <!-- 页面 / 卡片 / 分割（中性灰阶，分组式底色） -->
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F2F2F7" />
            <SolidColorBrush x:Key="PageBackgroundAcrylicBrush" Color="#B3F2F2F7" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#333C3C43" />
            <SolidColorBrush x:Key="DividerStrokeBrush" Color="#4A3C3C43" />

            <!-- 文本 -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D1D1F" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E73" />
            <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#AEAEB2" />

            <!-- 交互（强调色低透明度着色） -->
            <SolidColorBrush x:Key="HoverFillBrush" Color="#12007AFF" />
            <SolidColorBrush x:Key="PressedFillBrush" Color="#29007AFF" />

            <!-- 状态（填充/图标用） -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#34C759" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FF9500" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF3B30" />
            <SolidColorBrush x:Key="InfoBrush" Color="#007AFF" />

            <!-- 状态文字（浅色底上满足 WCAG AA） -->
            <SolidColorBrush x:Key="SuccessTextBrush" Color="#248A3D" />
            <SolidColorBrush x:Key="WarningTextBrush" Color="#C93400" />
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#D70015" />
            <SolidColorBrush x:Key="InfoTextBrush" Color="#0062CC" />

            <!-- 状态浅底（10% 透明度） -->
            <SolidColorBrush x:Key="SuccessChipFillBrush" Color="#1A34C759" />
            <SolidColorBrush x:Key="WarningChipFillBrush" Color="#1AFF9500" />
            <SolidColorBrush x:Key="ErrorChipFillBrush" Color="#1AFF3B30" />
            <SolidColorBrush x:Key="InfoChipFillBrush" Color="#1A007AFF" />

            <!-- 功耗标识（仅小面积标识使用，禁止大面积填充） -->
            <SolidColorBrush x:Key="PowerEcoBrush" Color="#34C759" />
            <SolidColorBrush x:Key="PowerBalancedBrush" Color="#007AFF" />
            <SolidColorBrush x:Key="PowerHighBrush" Color="#FF3B30" />
        </ResourceDictionary>

        <!-- ================= 深色模式 ================= -->
        <ResourceDictionary x:Key="Dark">

            <Color x:Key="SystemAccentColor">#0A84FF</Color>
            <Color x:Key="SystemAccentColorLight1">#409CFF</Color>
            <Color x:Key="SystemAccentColorLight2">#73B8FF</Color>
            <Color x:Key="SystemAccentColorLight3">#A6D4FF</Color>
            <Color x:Key="SystemAccentColorDark1">#0864C4</Color>
            <Color x:Key="SystemAccentColorDark2">#064C96</Color>
            <Color x:Key="SystemAccentColorDark3">#043569</Color>

            <!-- 品牌（深色提亮） -->
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#0A84FF" />
            <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#409CFF" />
            <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="#0864C4" />

            <!-- 页面 / 卡片 / 分割（中性炭灰阶，不用纯黑） -->
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#1C1C1E" />
            <SolidColorBrush x:Key="PageBackgroundAcrylicBrush" Color="#D91C1C1E" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2C2C2E" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#73545458" />
            <SolidColorBrush x:Key="DividerStrokeBrush" Color="#A6545458" />

            <!-- 文本 -->
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F7" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1A6" />
            <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#636366" />

            <!-- 交互 -->
            <SolidColorBrush x:Key="HoverFillBrush" Color="#1F0A84FF" />
            <SolidColorBrush x:Key="PressedFillBrush" Color="#330A84FF" />

            <!-- 状态 -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#30D158" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FF9F0A" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF453A" />
            <SolidColorBrush x:Key="InfoBrush" Color="#0A84FF" />

            <!-- 状态文字（深色底上提亮，满足 WCAG AA） -->
            <SolidColorBrush x:Key="SuccessTextBrush" Color="#30D158" />
            <SolidColorBrush x:Key="WarningTextBrush" Color="#FF9F0A" />
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF6961" />
            <SolidColorBrush x:Key="InfoTextBrush" Color="#409CFF" />

            <!-- 状态浅底（15% 透明度） -->
            <SolidColorBrush x:Key="SuccessChipFillBrush" Color="#2630D158" />
            <SolidColorBrush x:Key="WarningChipFillBrush" Color="#26FF9F0A" />
            <SolidColorBrush x:Key="ErrorChipFillBrush" Color="#26FF453A" />
            <SolidColorBrush x:Key="InfoChipFillBrush" Color="#260A84FF" />

            <!-- 功耗标识 -->
            <SolidColorBrush x:Key="PowerEcoBrush" Color="#30D158" />
            <SolidColorBrush x:Key="PowerBalancedBrush" Color="#0A84FF" />
            <SolidColorBrush x:Key="PowerHighBrush" Color="#FF453A" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
