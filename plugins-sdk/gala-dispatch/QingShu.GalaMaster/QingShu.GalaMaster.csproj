<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      元旦晚会智能分流 · 独立主控端（控制台版）。
      与工具箱内插件共享同一份 Gala 核心源码（下方 Compile 链接，单一事实源），
      不依赖 WinUI / 宿主程序集，可单独发布到任意常驻机器（远程桌面 / 计划任务均可）。
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QingShu.GalaMaster</AssemblyName>
    <RootNamespace>QingShu.GalaMaster</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- 共享核心（与插件工程同一份源码）：主控逻辑 + 拓扑模型/协议帧 + 压力模型 -->
    <Compile Include="..\core\Gala\GalaMaster.cs" />
    <Compile Include="..\core\Gala\GalaModels.cs" />
    <Compile Include="..\core\Gala\GalaPressure.cs" />
  </ItemGroup>

</Project>
