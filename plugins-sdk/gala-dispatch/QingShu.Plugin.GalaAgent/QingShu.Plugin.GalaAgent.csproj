<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      元旦晚会智能分流 · 服务端插件（被控终端用，常驻上报与执行指令）。
      与宿主完全一致的 TFM / SDK 投影 / MinVersion，保证跨 ALC 类型同一。
      Gala 核心（Agent 逻辑 + 模型/协议帧 + 压力模型）以 Compile 链接 ../core/Gala 共享源码（单一事实源）。
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <WindowsSdkPackageVersion>10.0.26100.86</WindowsSdkPackageVersion>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>QingShu.Plugin.GalaAgent</AssemblyName>
    <RootNamespace>QingShu.Plugin.GalaAgent</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!--
      宿主程序集目录（含 QingShu.Toolkit.exe 的发布目录）。探测顺序：
      ① -p:QingshuHome=...（命令行传参最可靠，不受 MSBuild 节点复用缓存旧环境的影响）
      ② 环境变量 QINGSHU_HOME（可能被复用的构建节点按旧环境求值，设了不生效时改用 ①）
      ③ 仓库内宿主发布目录自动探测（make_release.ps1 -o 与新版 SDK dotnet publish 的
         产物路径 bin\publish\win-x64；旧式 bin\x64\Release\...\publish 兼容探测）
      ④ C:\Tools\QingShu.Toolkit 默认值
      指定/探测的目录里找不到 QingShu.Toolkit.exe 时逐级向后兜底；
      全部落空由 EnsureHostAssemblyExists 报人话错误（含发布命令与传参示例）。
      契约（IQToolkitPlugin / IQToolkitUiProvider / IPluginContext）由宿主程序集提供，运行期类型同一。
    -->
    <QingshuHome Condition="!Exists('$(QingshuHome)\QingShu.Toolkit.exe') and Exists('$(MSBuildThisFileDirectory)..\..\..\src\QingShu.Toolkit\bin\publish\win-x64\QingShu.Toolkit.exe')">$(MSBuildThisFileDirectory)..\..\..\src\QingShu.Toolkit\bin\publish\win-x64</QingshuHome>
    <QingshuHome Condition="!Exists('$(QingshuHome)\QingShu.Toolkit.exe') and Exists('$(MSBuildThisFileDirectory)..\..\..\src\QingShu.Toolkit\bin\publish\QingShu.Toolkit.exe')">$(MSBuildThisFileDirectory)..\..\..\src\QingShu.Toolkit\bin\publish</QingshuHome>
    <QingshuHome Condition="!Exists('$(QingshuHome)\QingShu.Toolkit.exe') and Exists('$(MSBuildThisFileDirectory)..\..\..\src\QingShu.Toolkit\bin\x64\Release\net8.0-windows10.0.19041.0\win-x64\publish\QingShu.Toolkit.exe')">$(MSBuildThisFileDirectory)..\..\..\src\QingShu.Toolkit\bin\x64\Release\net8.0-windows10.0.19041.0\win-x64\publish</QingshuHome>
    <QingshuHome Condition="!Exists('$(QingshuHome)\QingShu.Toolkit.exe')">C:\Tools\QingShu.Toolkit</QingshuHome>
  </PropertyGroup>

  <ItemGroup>
    <!-- 版本必须与宿主一致：Microsoft.UI.Xaml.* 在默认加载上下文共享，跨 ALC 类型同一 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <Reference Include="QingShu.Toolkit">
      <HintPath>$(QingshuHome)\QingShu.Toolkit.exe</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 共享核心（与独立主控端/服务端程序同一份源码）：Agent 逻辑 + 拓扑模型/协议帧 + 压力模型（优先级名称等） -->
    <Compile Include="..\core\Gala\GalaAgent.cs" />
    <Compile Include="..\core\Gala\GalaModels.cs" />
    <Compile Include="..\core\Gala\GalaPressure.cs" />
  </ItemGroup>

  <!-- 宿主程序集缺失时直接报人话错误，不再吞成二十条 CS0246/CS0234 级联 -->
  <Target Name="EnsureHostAssemblyExists" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(QingshuHome)\QingShu.Toolkit.exe')"
           Text="找不到宿主程序集 QingShu.Toolkit.exe。已依次探测：-p:QingshuHome 与环境变量 QINGSHU_HOME 的指定值、仓库内 src/QingShu.Toolkit/bin/publish/win-x64、bin/publish、bin/x64/Release/net8.0-windows10.0.19041.0/win-x64/publish、C:\Tools\QingShu.Toolkit。最可靠做法：先发布宿主，再把 dotnet publish 输出「→」后面的发布目录以 -p:QingshuHome=&quot;目录&quot; 传给本构建（环境变量可能被 MSBuild 节点复用吞掉，命令行传参必生效）。宿主发布命令：dotnet publish src/QingShu.Toolkit -c Release -p:Platform=x64 -r win-x64 --self-contained -p:WindowsAppSDKSelfContained=true" />
  </Target>

</Project>
