<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      元旦晚会智能分流 · 服务端插件（被控终端用，常驻上报与执行指令）。
      与宿主完全一致的 TFM / SDK 投影 / MinVersion，保证跨 ALC 类型同一。
      Gala 核心（Agent 逻辑 + 模型/协议帧 + 压力模型）以 Compile 链接 ../core/Gala 共享源码（单一事实源）。
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <WindowsSdkPackageVersion>10.0.26100.86</WindowsSdkPackageVersion>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>QingShu.Plugin.GalaAgent</AssemblyName>
    <RootNamespace>QingShu.Plugin.GalaAgent</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!--
      宿主程序集目录（含 QingShu.Toolkit.exe 的发布目录）。
      优先级：-p:QingshuHome=... > 环境变量 QINGSHU_HOME > 仓库内宿主发布目录（若已发布）> C:\Tools 默认。
      契约（IQToolkitPlugin / IQToolkitUiProvider / IPluginContext）由宿主程序集提供，运行期类型同一。
    -->
    <QingshuHome Condition="'$(QingshuHome)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\src\QingShu.Toolkit\bin\x64\Release\net8.0-windows10.0.19041.0\win-x64\publish\QingShu.Toolkit.exe')">$(MSBuildThisFileDirectory)..\..\..\src\QingShu.Toolkit\bin\x64\Release\net8.0-windows10.0.19041.0\win-x64\publish</QingshuHome>
    <QingshuHome Condition="'$(QingshuHome)' == ''">C:\Tools\QingShu.Toolkit</QingshuHome>
  </PropertyGroup>

  <ItemGroup>
    <!-- 版本必须与宿主一致：Microsoft.UI.Xaml.* 在默认加载上下文共享，跨 ALC 类型同一 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <Reference Include="QingShu.Toolkit">
      <HintPath>$(QingshuHome)\QingShu.Toolkit.exe</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 共享核心（与独立主控端/服务端程序同一份源码）：Agent 逻辑 + 拓扑模型/协议帧 + 压力模型（优先级名称等） -->
    <Compile Include="..\core\Gala\GalaAgent.cs" />
    <Compile Include="..\core\Gala\GalaModels.cs" />
    <Compile Include="..\core\Gala\GalaPressure.cs" />
  </ItemGroup>

  <!-- 宿主程序集缺失时直接报人话错误，不再吞成二十条 CS0246/CS0234 级联 -->
  <Target Name="EnsureHostAssemblyExists" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(QingshuHome)\QingShu.Toolkit.exe')"
           Text="找不到宿主程序集：$(QingshuHome)\QingShu.Toolkit.exe 不存在。请先发布宿主（仓库根执行 dotnet publish src/QingShu.Toolkit -c Release -p:Platform=x64 -r win-x64 --self-contained -p:WindowsAppSDKSelfContained=true），再设置 PowerShell 环境变量 $env:QINGSHU_HOME 指向发布目录后重新构建；或在构建命令追加 -p:QingshuHome=&quot;宿主发布目录&quot;。" />
  </Target>

</Project>
